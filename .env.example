# Variáveis do docker compose. Copie para .env antes de subir o ambiente:
#
#   cp .env.example .env
#
# As variáveis da aplicação em si ficam em backend/.env.

APP_ENV=local
APP_DEBUG=false

# Banco principal. Não existe valor padrão de propósito: subir um MySQL com
# senha conhecida na porta 3306 da máquina é como deixar a porta encostada.
MYSQL_ROOT_PASSWORD=
DB_DATABASE=koracrm
DB_USERNAME=koracrm
DB_PASSWORD=
