# Docker Compose - KoraCRM
# Copie para .env e preencha os valores antes de rodar: docker-compose up -d

# Aplicacao
APP_ENV=local
APP_DEBUG=false

# MySQL - banco principal
MYSQL_ROOT_PASSWORD=TROQUE_POR_SENHA_FORTE
MYSQL_PASSWORD=TROQUE_POR_SENHA_FORTE

# MySQL - banco de testes (opcional, valores padrao seguros para dev)
MYSQL_ROOT_PASSWORD_TEST=TROQUE_POR_SENHA_FORTE
MYSQL_PASSWORD_TEST=TROQUE_POR_SENHA_FORTE
