APP_NAME=KoraCRM
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=koracrm
DB_USERNAME=koracrm_user
DB_PASSWORD=TROQUE_POR_SENHA_FORTE

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=koracrm_

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# AWS S3: Armazenamento de arquivos
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=koracrm-uploads
AWS_USE_PATH_STYLE_ENDPOINT=false

# Sanctum: Autenticação SPA
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:5173
SESSION_DOMAIN=localhost

# Rate Limiting
RATE_LIMIT_API=60
RATE_LIMIT_LOGIN=5

# CORS
FRONTEND_URL=http://localhost:3000

# Mail
MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@koracrm.com.br
MAIL_FROM_NAME="${APP_NAME}"

# Swagger
L5_SWAGGER_GENERATE_ALWAYS=true

# Seed: senhas dos usuários de exemplo (deixe em branco para gerar aleatórias)
SEED_ADMIN_PASSWORD=
SEED_GERENTE_PASSWORD=
SEED_VENDEDOR_PASSWORD=
