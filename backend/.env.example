APP_NAME=KoraCRM
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost
APP_VERSAO=1.0.0

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=koracrm
DB_USERNAME=koracrm
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=koracrm_

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Arquivos anexados ao lead. Com FILESYSTEM_DISK=s3 o anexo vai para o bucket
# e a leitura passa a ser por URL assinada de uma hora.
#
# Para o S3 local do docker compose (perfil aws):
#   AWS_ENDPOINT=http://localstack:4566
#   AWS_ACCESS_KEY_ID=teste
#   AWS_SECRET_ACCESS_KEY=teste
#   AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=koracrm-uploads
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Sanctum: sessão da aplicação de página única
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:5173
SESSION_DOMAIN=localhost

# Origem liberada no CORS. Uma só, e com esquema e porta.
FRONTEND_URL=http://localhost:3000

# E-mail
MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@koracrm.com.br
MAIL_FROM_NAME="${APP_NAME}"

# Documentação da API. Em produção fica false: gerar a cada requisição custa
# tempo e expõe rota que ninguém de fora precisa.
L5_SWAGGER_GENERATE_ALWAYS=true
